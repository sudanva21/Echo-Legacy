# ==============================================================================
# EcoLegacy — Environment Variables Configuration Template
# ==============================================================================
# Copy this file to:
# 1. web/.env.local (for Next.js web application and Python scripts)
# 2. .env (optional, in the project root for Python scripts)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SUPABASE DATABASE & AUTHENTICATION (Required)
# ------------------------------------------------------------------------------
# Create a free project at https://supabase.com
# Found under: Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_URL=https://your-project-id.supabase.co
# Found under: Project Settings -> API -> Project API Keys -> service_role (secret)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ------------------------------------------------------------------------------
# 2. LLM INFERENCE APIS (Required for Chat Generation)
# ------------------------------------------------------------------------------
# Groq Cloud API (Free & ultra-fast Llama-3.1-8b-instant): https://console.groq.com
GROQ_API_KEY=gsk_your_groq_api_key_here

# Google Gemini API (Alternative/Fallback): https://aistudio.google.com
GEMINI_API_KEY=your_gemini_api_key_here

# ------------------------------------------------------------------------------
# 3. VOICE CLONING APIS (Choose at least one)
# ------------------------------------------------------------------------------
# Smallest.ai API (Primary voice cloning): https://app.smallest.ai
SMALLEST_API_KEY=sk_your_smallest_ai_key_here

# Hugging Face Access Token (For F5-TTS ZeroGPU Space fallback): https://huggingface.co/settings/tokens
HUGGINGFACE_TOKEN=hf_your_primary_token_here

# Optional: Backup HF tokens to rotate through to bypass ZeroGPU hourly quota limits
HUGGINGFACE_TOKEN_1=
HUGGINGFACE_TOKEN_2=
HUGGINGFACE_TOKEN_3=
HUGGINGFACE_TOKEN_4=
HUGGINGFACE_TOKEN_5=

# ------------------------------------------------------------------------------
# 4. LOCAL SERVERS & NETWORK TUNNELS (Optional)
# ------------------------------------------------------------------------------
# Local Python TTS server URL (when running smallest_tts_server.py or minimal_tts_server.py)
LOCAL_TTS_URL=http://localhost:5000
LOCAL_TTS_TIMEOUT_MS=120000

# Ngrok tunnel URL for LivePortrait/Wav2Lip video lip-syncing (Optional)
# Leave blank to fallback to static interactive portraits
NGROK_URL=

# App deployment domain (used for internal rate-limit fetch calls)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
